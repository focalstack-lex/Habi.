# Application Settings
VITE_APP_TITLE="Habi - Davao Local Fashion Discovery Platform"
VITE_API_URL="http://localhost:3000/api"
VITE_REGION_DEFAULT="Davao City"

# Admin registration. Anyone with this key can create an admin account from the
# sign-in page, so change it before sharing a build. Falls back to "habi-admin-2026"
# in development when unset.
VITE_ADMIN_SETUP_KEY="change-me-before-deploy"

# Automated PhilSys National ID check through the eGov / PSA eVerify programme.
# Point this at YOUR backend proxy that holds the eVerify API key (never put the
# key in this file; anything prefixed VITE_ ships to the browser). Leave empty to
# skip the automated check and rely on admin review. See docs/ID_VERIFICATION.md.
VITE_ID_VERIFY_ENDPOINT=""
